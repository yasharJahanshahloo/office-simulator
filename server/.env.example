# Bale bot token from @botfather
BALE_BOT_TOKEN=
# Comma-separated Bale user ids with admin rights
ADMIN_IDS=
# 64 hex chars (32 bytes). Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
CREDENTIAL_KEY=
# URL employee machines use to reach this server (baked into setup zips)
PUBLIC_URL=http://localhost:8090
PORT=8090
DATA_DIR=./data
